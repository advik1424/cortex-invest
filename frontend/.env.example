# ==============================================================================
# CORTEX INVEST - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Spring Boot 3 API URL (Leave blank for local proxy / dev server)
# When deploying frontend on Vercel/Netlify and backend on Render:
# VITE_API_BASE_URL=https://cortex-invest-backend.onrender.com
VITE_API_BASE_URL=

# Official Google OAuth 2.0 Web Client ID
# Obtain from: https://console.cloud.google.com/apis/credentials
# Format: XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
